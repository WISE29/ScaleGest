# Copier ce fichier en .env et remplir les valeurs

# Clé secrète Flask (générer avec : python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=changez-moi-en-production

# URL de connexion PostgreSQL
# Local  : postgresql://user:password@localhost:5432/chatter_manager
# Render : fourni automatiquement par la plateforme
DATABASE_URL=postgresql://user:password@localhost:5432/chatter_manager

# Mode debug (True en dev, False en prod)
FLASK_DEBUG=True

# Compte manager initial créé au premier démarrage
INIT_MANAGER_USERNAME=manager
INIT_MANAGER_PASSWORD=changez-moi
